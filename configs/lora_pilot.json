{
  "train_files": ["data/hf.jsonl", "data/synthetic.jsonl"],
  "val_files": ["data/hf.jsonl", "data/synthetic.jsonl", "data/eval.jsonl"],
  "out_dir": "runs/lora_pilot",
  "seed": 13,
  "dtype": "bfloat16",
  "max_length": 2048,
  "max_batch_tokens": 8192,
  "grad_accum": 4,
  "epochs": 1,
  "lr": 2e-4,
  "warmup_ratio": 0.05,
  "weight_decay": 0.0,
  "max_grad_norm": 1.0,
  "gradient_checkpointing": true,
  "eval_every": 50,
  "max_val_questions": 1200,
  "max_train_per_family": 1600,
  "lora": {"r": 16, "alpha": 32, "dropout": 0.05, "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"]}
}
